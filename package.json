{
  "name": "phaseplay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @phaseplay/api db:migrate:local && pnpm --filter @phaseplay/api db:seed && pnpm -r --parallel --filter \"./apps/*\" dev",
    "check": "eslint . && prettier --check . && pnpm -r --parallel check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @phaseplay/web build && pnpm --filter @phaseplay/api build",
    "size": "node scripts/size-check.mjs",
    "db:migrate:local": "pnpm --filter @phaseplay/api db:migrate:local",
    "db:seed": "pnpm --filter @phaseplay/api db:seed",
    "deploy": "bash scripts/cf-deploy.sh",
    "demo:prod": "node scripts/demo-prod.mjs",
    "cf:build": "bash scripts/cf-build.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
